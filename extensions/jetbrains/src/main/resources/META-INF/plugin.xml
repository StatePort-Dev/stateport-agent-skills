<idea-plugin>
  <id>dev.stateport.jetbrains</id>
  <name>StatePort Debugging</name>
  <version>0.1.0-alpha.8</version>
  <vendor url="https://github.com/StatePort-Dev">StatePort-Dev</vendor>
  <description>Prepare exact StatePort Card handoff and locate local MCP setup for an agent.</description>
  <depends>com.intellij.modules.platform</depends>
  <actions>
    <action id="dev.stateport.jetbrains.copyCardHandoff"
            class="dev.stateport.jetbrains.CopyCardHandoffAction"
            text="StatePort: Copy Exact Card Handoff"
            description="Copy a supplied Card and revision for an agent to inspect through StatePort MCP">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
    <action id="dev.stateport.jetbrains.showSetup"
            class="dev.stateport.jetbrains.ShowSetupAction"
            text="StatePort: Connect Agent Help"
            description="Show the supported local AI Assistant MCP setup path">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
